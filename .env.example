# Supabase connection (Vite only reads VITE_* — restart dev after changing).
# Get these from the Sinsay Supabase project dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Live tables expected by src/lib/queries.ts + staff-auth.ts (migration 030):
#   to_staff, operator_applications, payment_transactions,
#   dive_pass_inventory, tourists
# Private storage bucket for receipt uploads (signed URLs, 1h TTL):
#   operator_uploads
# NOTE: VITE_* vars are baked at build time (see vite.config.ts). On Vercel,
# set them as Environment Variables BEFORE `bun run build`, then redeploy
# after any rotation.
